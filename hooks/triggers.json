[
  {
    "rule": "finishing-branch",
    "action": "Read rules/rule-finishing-branch.md 并走 Gate TB/PR",
    "patterns": [
      "提\\s*个?\\s*pr",
      "创建\\s*pr",
      "建\\s*个?\\s*pr",
      "pull\\s*request",
      "提.*?PR",
      "合并到\\s*(release|main|master|主干)",
      "收尾",
      "完成\\s*worktree",
      "删\\s*(branch|分支)",
      "discard\\s*worktree"
    ],
    "note": "Bitbucket 用 bkt 不裸 curl; reviewer 用 bkt pr edit 不 PUT。"
  },
  {
    "rule": "push-summary",
    "action": "Read rules/rule-push-summary.md",
    "patterns": [
      "总结.{0,4}push",
      "push.{0,6}(总结|包含|改了|是什么)",
      "pr\\s*描述",
      "pr\\s*description",
      "给.{0,4}(标题|描述)",
      "沉淀",
      "这次\\s*push"
    ],
    "note": ""
  }
]
