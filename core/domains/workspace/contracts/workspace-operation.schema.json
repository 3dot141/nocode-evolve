{
  "$id": "workspace.workspace-operation",
  "type": "object",
  "required": ["operation"],
  "properties": { "operation": { "enum": ["read", "write", "exec", "browser.verify", "worktree.current", "worktree.create", "worktree.enter"] }, "path": { "type": "string" }, "content": { "type": "string" }, "argv": { "type": "array", "items": { "type": "string" } }, "url": { "type": "string" }, "branch": { "type": "string" }, "startPoint": { "type": "string" } },
  "oneOf": [
    { "required": ["operation", "path"], "properties": { "operation": { "const": "read" } } },
    { "required": ["operation", "path", "content"], "properties": { "operation": { "const": "write" } } },
    { "required": ["operation", "argv"], "properties": { "operation": { "const": "exec" } } },
    { "required": ["operation", "url"], "properties": { "operation": { "const": "browser.verify" } } },
    { "required": ["operation"], "properties": { "operation": { "const": "worktree.current" } } },
    { "required": ["operation", "branch", "path"], "properties": { "operation": { "const": "worktree.create" } } },
    { "required": ["operation", "path"], "properties": { "operation": { "const": "worktree.enter" } } }
  ],
  "additionalProperties": false
}
