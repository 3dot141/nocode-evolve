{
  "id": "inline",
  "execution": "native",
  "pluginData": false,
  "domain": "workflow",
  "platforms": [
    "claude",
    "codex"
  ],
  "capabilities": {
    "workflow.skill.invoke": {
      "inputSchema": {
        "type": "object",
        "required": [
          "skill",
          "arguments"
        ],
        "properties": {
          "skill": {
            "type": "string"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "status",
          "resultRef",
          "result"
        ],
        "properties": {
          "status": {
            "enum": [
              "completed",
              "failed"
            ]
          },
          "resultRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {}
        },
        "additionalProperties": false
      }
    },
    "workflow.execute": {
      "inputSchema": "contracts/task-graph.schema.json",
      "outputSchema": "contracts/execution-receipt.schema.json"
    },
    "workflow.wait": {
      "inputSchema": {
        "type": "object",
        "required": [
          "executionId"
        ],
        "properties": {
          "executionId": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": "contracts/execution-receipt.schema.json"
    },
    "workflow.followup": {
      "inputSchema": {
        "type": "object",
        "required": [
          "executionId",
          "taskId",
          "instruction"
        ],
        "properties": {
          "executionId": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": "contracts/execution-receipt.schema.json"
    },
    "workflow.collect": {
      "inputSchema": {
        "type": "object",
        "required": [
          "executionId"
        ],
        "properties": {
          "executionId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": "contracts/execution-receipt.schema.json"
    },
    "workflow.cancel": {
      "inputSchema": {
        "type": "object",
        "required": [
          "executionId",
          "reason"
        ],
        "properties": {
          "executionId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": "contracts/execution-receipt.schema.json"
    },
    "workflow.plan.create": {
      "inputSchema": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "subject",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pending",
                    "in_progress",
                    "completed"
                  ]
                },
                "handoff": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "planRef"
        ],
        "properties": {
          "planRef": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "workflow.plan.update": {
      "inputSchema": {
        "type": "object",
        "required": [
          "planRef",
          "items"
        ],
        "properties": {
          "planRef": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "subject",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pending",
                    "in_progress",
                    "completed"
                  ]
                },
                "handoff": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "planRef"
        ],
        "properties": {
          "planRef": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "workflow.decision.request": {
      "inputSchema": {
        "type": "object",
        "required": [
          "question",
          "options"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "description"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "allowFreeform": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "selectedOption": {
            "type": "string"
          },
          "freeform": {
            "type": "string"
          }
        },
        "oneOf": [
          {
            "required": [
              "selectedOption"
            ]
          },
          {
            "required": [
              "freeform"
            ]
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "dependencies": [
    "state.execution.create",
    "state.execution.recover",
    "state.execution.read",
    "state.execution.update",
    "state.execution.cleanup"
  ]
}
