{
  "id": "codex-agents",
  "execution": "native",
  "pluginData": false,
  "domain": "workflow",
  "platforms": [
    "codex"
  ],
  "capabilities": {
    "workflow.execute": {
      "inputSchema": "contracts/task-graph.schema.json",
      "outputSchema": "contracts/execution-receipt.schema.json"
    },
    "workflow.wait": {
      "inputSchema": {
        "type": "object",
        "required": [
          "executionId"
        ],
        "properties": {
          "executionId": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": "contracts/execution-receipt.schema.json"
    },
    "workflow.followup": {
      "inputSchema": {
        "type": "object",
        "required": [
          "executionId",
          "taskId",
          "instruction"
        ],
        "properties": {
          "executionId": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": "contracts/execution-receipt.schema.json"
    },
    "workflow.collect": {
      "inputSchema": {
        "type": "object",
        "required": [
          "executionId"
        ],
        "properties": {
          "executionId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": "contracts/execution-receipt.schema.json"
    },
    "workflow.cancel": {
      "inputSchema": {
        "type": "object",
        "required": [
          "executionId",
          "reason"
        ],
        "properties": {
          "executionId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": "contracts/execution-receipt.schema.json"
    }
  },
  "dependencies": [
    "state.execution.create",
    "state.execution.recover",
    "state.execution.read",
    "state.execution.update",
    "state.execution.cleanup",
    "workspace.write"
  ]
}
