{
  "$id": "workflow.control-input",
  "type": "object",
  "properties": {
    "operation": { "type": "string" },
    "executionId": { "type": "string" },
    "planRef": { "type": "string" },
    "timeoutMs": { "type": "integer" },
    "taskId": { "type": "string" },
    "instruction": { "type": "string" },
    "reason": { "type": "string" },
    "skill": { "type": "string" },
    "arguments": { "type": "object", "additionalProperties": true },
    "items": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "id": { "type": "string" },
    "status": { "type": "string" },
    "subject": { "type": "string" },
    "question": { "type": "string" },
    "options": { "type": "array", "items": { "type": "object", "required": ["label", "description"], "properties": { "label": { "type": "string" }, "description": { "type": "string" } }, "additionalProperties": false } },
    "allowFreeform": { "type": "boolean" }
  },
  "oneOf": [
    { "required": ["operation", "executionId"], "properties": { "operation": { "enum": ["wait", "collect"] } } },
    { "required": ["operation", "executionId", "taskId", "instruction"], "properties": { "operation": { "const": "followup" } } },
    { "required": ["operation", "executionId", "reason"], "properties": { "operation": { "const": "cancel" } } },
    { "required": ["operation", "skill", "arguments"], "properties": { "operation": { "const": "skill.invoke" } } },
    { "required": ["operation", "items"], "properties": { "operation": { "const": "plan.create" } } },
    { "required": ["operation", "planRef", "items"], "properties": { "operation": { "const": "plan.update" } } },
    { "required": ["operation", "question", "options"], "properties": { "operation": { "const": "decision.request" } } }
  ],
  "additionalProperties": false
}
