                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "pending",
                        "running",
                        "completed",
                        "failed",
                        "skipped",
                        "cancelled"
                      ]
                    },
                    "resultRef": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "result": {},
                    "error": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": true
                    },
                    "reviewMode": {
                      "enum": [
                        "cross-model",
                        "isolated-same-model",
                        "inline-self-review",
                        null
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "outputSchema": "contracts/execution-state.schema.json"
    },
