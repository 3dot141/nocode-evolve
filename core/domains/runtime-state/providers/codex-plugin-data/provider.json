      "inputSchema": {
        "type": "object",
        "required": [
          "sessionId",
          "executionId",
          "provider",
          "patch"
        ],
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "executionId": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "patch": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "running",
                  "completed",
                  "partial",
                  "failed",
                  "cancelled"
