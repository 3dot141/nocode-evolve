    ],
    "safeFailureExitCodes": []
  },
  "domain": "runtime-state",
  "platforms": [
    "codex"
  ],
  "capabilities": {
    "state.cleanup": {
      "inputSchema": {
        "type": "object",
        "required": [
          "sessionId"
        ],
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "retentionMs": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": "contracts/session-state.schema.json"
    },
    "state.execution.cleanup": {
      "inputSchema": {
        "type": "object",
        "required": [
          "sessionId"
        ],
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "retentionMs": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "removed",
          "retained"
        ],
        "properties": {
          "removed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retained": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "state.execution.create": {
      "inputSchema": {
        "type": "object",
        "required": [
          "sessionId",
          "execution"
        ],
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "execution": {
            "type": "object",
            "required": [
              "provider",
              "graph",
              "tasks"
            ],
            "properties": {
              "executionId": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pending",
                  "running",
                  "completed",
                  "partial",
                  "failed",
                  "cancelled"
                ]
              },
              "cancelReason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "providerHandle": {
                "type": "object",
                "additionalProperties": true
              },
              "graph": {
                "$ref": "workflow.task-graph"
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "pending",
                        "running",
                        "completed",
                        "failed",
                        "skipped",
                        "cancelled"
                      ]
                    },
                    "resultRef": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "result": {},
                    "error": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": true
                    },
                    "reviewMode": {
                      "enum": [
                        "cross-model",
                        "isolated-same-model",
                        "inline-self-review",
                        null
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "outputSchema": "contracts/execution-state.schema.json"
    },
    "state.execution.read": {
      "inputSchema": {
        "type": "object",
        "required": [
          "sessionId",
          "executionId"
        ],
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "executionId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": "contracts/execution-state.schema.json"
    },
    "state.execution.recover": {
