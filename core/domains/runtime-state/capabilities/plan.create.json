{
  "id": "state.plan.create",
  "domain": "runtime-state",
  "inputSchema": {
    "type": "object",
    "required": ["sessionId", "plan"],
    "properties": {
      "sessionId": { "type": "string" },
      "plan": {
        "type": "object",
        "required": ["provider", "items"],
        "properties": {
          "planRef": { "type": "string" },
          "provider": { "type": "string" },
          "providerHandle": { "type": "object", "additionalProperties": true },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "subject", "status"],
              "properties": {
                "id": { "type": "string" },
                "subject": { "type": "string" },
                "description": { "type": "string" },
                "status": { "enum": ["pending", "in_progress", "completed"] },
                "handoff": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "outputSchema": "contracts/plan-state.schema.json",
  "fallbackOn": "never",
  "platforms": { "claude": { "primary": "claude-plugin-data" }, "codex": { "primary": "codex-plugin-data" } }
}
