{
  "id": "state.execution.cleanup",
  "domain": "runtime-state",
  "inputSchema": {
    "type": "object",
    "required": ["sessionId"],
    "properties": {
      "sessionId": { "type": "string" },
      "retentionMs": { "type": "integer" }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": ["removed", "retained"],
    "properties": {
      "removed": { "type": "array", "items": { "type": "string" } },
      "retained": { "type": "array", "items": { "type": "string" } }
    },
    "additionalProperties": false
  },
  "fallbackOn": "never",
  "platforms": {
    "claude": { "primary": "claude-plugin-data" },
    "codex": { "primary": "codex-plugin-data" }
  }
}
