{
  "id": "design.artifact.read",
  "domain": "design",
  "inputSchema": {
    "type": "object",
    "required": [
      "artifactRef"
    ],
    "properties": {
      "artifactRef": {
        "allOf": [
          { "$ref": "design.design-result" },
          {
            "type": "object",
            "required": ["artifact"],
            "properties": { "artifact": { "type": "object" } }
          }
        ]
      }
    },
    "additionalProperties": false
  },
  "outputSchema": "contracts/design-result.schema.json",
  "fallbackOn": "manual",
  "platforms": {
    "claude": {
      "primaryFromInput": "artifactRef.provider",
      "allowedProviders": ["open-design", "local-html"],
      "fallback": "local-html",
      "fallbackCondition": "artifactRef.artifact.localPath"
    },
    "codex": {
      "primaryFromInput": "artifactRef.provider",
      "allowedProviders": ["open-design", "local-html"],
      "fallback": "local-html",
      "fallbackCondition": "artifactRef.artifact.localPath"
    }
  }
}
