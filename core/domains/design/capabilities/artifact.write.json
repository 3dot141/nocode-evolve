{
  "id": "design.artifact.write",
  "domain": "design",
  "inputSchema": {
    "type": "object",
    "required": [
      "artifactRef"
    ],
    "properties": {
      "artifactRef": {
        "allOf": [
          { "$ref": "design.design-result" },
          {
            "type": "object",
            "required": ["artifact"],
            "properties": { "artifact": { "type": "object" } }
          }
        ]
      },
      "content": {
        "type": "string"
      },
      "patch": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "oneOf": [
      {
        "required": [
          "content"
        ]
      },
      {
        "required": [
          "patch"
        ]
      }
    ],
    "additionalProperties": false
  },
  "outputSchema": "contracts/design-result.schema.json",
  "fallbackOn": "never",
  "platforms": {
    "claude": {
      "primaryFromInput": "artifactRef.provider",
      "allowedProviders": ["open-design", "local-html"]
    },
    "codex": {
      "primaryFromInput": "artifactRef.provider",
      "allowedProviders": ["open-design", "local-html"]
    }
  }
}
