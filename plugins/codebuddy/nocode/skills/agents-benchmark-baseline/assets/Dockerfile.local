# 本地对照组镜像：与仓内 CI Dockerfile 同源，唯一差异是剥离 publish:all
# （本地构建不应向私有 npm 发布包；CI 的 Dockerfile 保持不动）。
#
# 承载内容 = persist 分支代码 + 观测面补丁（server.sessionTraceExport，见工作区未提交改动）。
#
# 用法（在 fx-data-agents-persist 仓根目录执行）：
#   docker build -f Dockerfile.local -t fx-data-agents-baseline:persist .

FROM node:22.14.0 AS build

WORKDIR /app

ENV TZ=Asia/Shanghai

COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY app/package.json ./app/
COPY packages/shared/package.json ./packages/shared/
COPY packages/client/package.json ./packages/client/
COPY packages/desktop/package.json ./packages/desktop/
COPY packages/server/package.json ./packages/server/
COPY packages/ui/package.json ./packages/ui/

RUN npm config set registry https://registry.npmmirror.com && \
    npm install -g pnpm@10.33.0

RUN pnpm install

COPY . .

# 镜像内不需要 benchmark 包: 体积大、依赖 playwright
RUN rm -rf packages/benchmark

ENV NODE_ENV=production

RUN pnpm run build

FROM build AS agent-all

ENV NODE_ENV=production

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8071

ENTRYPOINT ["sh", "/entrypoint.sh"]
