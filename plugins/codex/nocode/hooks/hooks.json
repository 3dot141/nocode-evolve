{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inject-nocode.sh model-about"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inject-nocode.sh model-personal"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inject-nocode.sh model-karpathy"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inject-nocode.sh model-rule-catalog-1"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inject-nocode.sh model-rule-catalog-2"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inject-nocode.sh model-rule-catalog-3"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inject-nocode.sh model-rule-catalog-4"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inject-nocode.sh model-rule-catalog-5"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inject-nocode.sh project"
          },
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/personal-snapshot.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/pretooluse-guard.mjs"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/skills/continuous-learning-v2/hooks/observe.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/skills/continuous-learning-v2/hooks/observe.sh"
          }
        ]
      }
    ]
  }
}
